# ==============================================================================
# EdgeStore Appliance Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and configure strong values for production deployments.
# NEVER commit real secret keys, credentials, or production tokens to Git!

# --- System & Deployment Mode ---
# Options: simulation | raspberry_pi
ENVIRONMENT_MODE=simulation
HOST=127.0.0.1
PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# --- Security & JWT ---
# CRITICAL: Generate a strong 256-bit random secret in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_strong_random_secret_in_production_minimum_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database ---
DATABASE_URL=sqlite:///./edgestore.db

# --- Hardware Paths (Raspberry Pi Mode) ---
LINUX_PRIMARY_DEVICE=/dev/mapper/edgestore_primary
LINUX_PRIMARY_MOUNT=/mnt/edgestore/primary
LINUX_REPLICA_DEVICE=/dev/mapper/edgestore_replica
LINUX_REPLICA_MOUNT=/mnt/edgestore/replica
LINUX_KEY_SD_DEVICE_UUID=EDGESTORE-KEY-01
LINUX_KEY_SD_MOUNT=/mnt/edgestore/key_sd
LINUX_KEY_FILE_NAME=vault.key

# --- Simulation Storage Paths ---
SIMULATION_PRIMARY_PATH=./simulation/primary
SIMULATION_REPLICA_PATH=./simulation/replica
SIMULATION_KEY_SD_PATH=./simulation/key_sd

# --- Cybersecurity Hardening Settings ---
# Brute-force protection: Lockout entity after 5 failed attempts for 300 seconds (5 min)
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_DEFAULT_REQUESTS=120

# Maximum request payload size in bytes (Default: 100 MB)
MAX_UPLOAD_SIZE_BYTES=104857600

# CORS Allowed Origins (Comma-separated or list)
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# Enable HTTP Security Headers (CSP, X-Frame-Options, etc.)
ENABLE_SECURITY_HEADERS=True

# Set True when deploying with TLS/HTTPS to enforce HSTS
STRICT_TRANSPORT_SECURITY=False

# --- Initial Admin Account Provisioning ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=AdminEdgeStore2026!
INITIAL_ADMIN_EMAIL=admin@edgestore.local
