# ==============================================================================
# EdgeStore Appliance Custom Production Environment Configuration (.env)
# ==============================================================================
# Use this configuration to deploy EdgeStore as your own private, hardened appliance.
# NEVER commit your production .env file to public Git repositories!

# --- System & Deployment Mode ---
# Options: docker | simulation | raspberry_pi
ENVIRONMENT_MODE=docker
HOST=0.0.0.0
PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# --- Administrator Account Provisioning ---
# Configure your own custom administrator credentials for the appliance.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeThisPasswordNow2026!
INITIAL_ADMIN_EMAIL=admin@my-edgestore.local

# --- Cryptographic Security & JWT ---
# CRITICAL: Generate a cryptographically secure 256-bit hexadecimal string (min 32 bytes)
# Example command to generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_your_own_custom_256bit_random_jwt_secret_hex_string_32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Primary & Secondary Storage Volumes ---
# In Docker mode, these map to Docker named volumes or host directory bind-mounts
PRIMARY_STORAGE_VOLUME=edgestore_primary
REPLICA_STORAGE_VOLUME=edgestore_replica
DB_STORAGE_VOLUME=edgestore_db

# Custom named volume overrides
PRIMARY_VOLUME_NAME=edgestore_custom_primary
REPLICA_VOLUME_NAME=edgestore_custom_replica
DB_VOLUME_NAME=edgestore_custom_db
MONGO_VOLUME_NAME=edgestore_custom_mongo

# Minimum free disk headroom required before uploads are rejected (in bytes, default 10MB)
MIN_FREE_DISK_BYTES=10485760
MAX_UPLOAD_SIZE_BYTES=104857600

# --- MongoDB Client Storage ---
MONGO_PORT=27017
MONGO_DB_NAME=edgestore_clients
MONGO_URI=mongodb://mongo:27017

# --- Database URL (SQLite inside container) ---
DATABASE_URL=sqlite:////data/db/edgestore.db

# --- Cybersecurity Hardening Settings ---
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_DEFAULT_REQUESTS=120

# CORS Allowed Origins
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000","http://localhost:4200","http://127.0.0.1:4200","http://localhost:3000","http://127.0.0.1:3000"]

# HTTP Security Headers
ENABLE_SECURITY_HEADERS=True
STRICT_TRANSPORT_SECURITY=False
