# EdgeStore Configuration
# Environment Modes: 'simulation' or 'raspberry_pi'
ENVIRONMENT_MODE=simulation

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Security / JWT
# Generate secure secret with: openssl rand -hex 32
JWT_SECRET=edgestore_phase1_super_secret_jwt_key_change_in_production_32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite:///./edgestore.db

# Storage Paths (Simulation mode paths)
SIMULATION_PRIMARY_PATH=./simulation/primary
SIMULATION_REPLICA_PATH=./simulation/replica
SIMULATION_KEY_SD_PATH=./simulation/key_sd

# Real Hardware Paths (Raspberry Pi mode)
LINUX_PRIMARY_DEVICE=/dev/mapper/edgestore_primary
LINUX_PRIMARY_MOUNT=/mnt/edgestore/primary
LINUX_REPLICA_DEVICE=/dev/mapper/edgestore_replica
LINUX_REPLICA_MOUNT=/mnt/edgestore/replica
LINUX_KEY_SD_DEVICE_UUID=EDGESTORE-KEY-01
LINUX_KEY_SD_MOUNT=/mnt/edgestore/key_sd
LINUX_KEY_FILE_NAME=vault.key

# Replication Settings
REPLICATION_INTERVAL_SECONDS=10
AUTO_RETRY_FAILED_REPLICATIONS=true
MAX_REPLICATION_RETRIES=3

# Power Policy Thresholds (Configurable Engineering Parameters)
BATTERY_NORMAL_THRESHOLD=50
BATTERY_CONSERVATION_THRESHOLD=25
BATTERY_CRITICAL_THRESHOLD=10

# System Initial Admin Credentials
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=AdminEdgeStore2026!
INITIAL_ADMIN_EMAIL=admin@edgestore.local
