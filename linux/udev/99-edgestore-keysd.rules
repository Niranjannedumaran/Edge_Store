# EdgeStore Key-SD Physical Authentication Udev Rules
# Triggers automated hardware unlock on insertion and safe vault unmount/lock on removal.
# Stable UUID matches partition format generated by setup_keysd.sh

# Key-SD Insertion Event
ACTION=="add", SUBSYSTEM=="block", ENV{ID_FS_UUID}=="EDGESTORE-KEY-01", RUN+="/usr/bin/systemctl start edgestore-unlock.service"

# Key-SD Removal Event
ACTION=="remove", SUBSYSTEM=="block", ENV{ID_FS_UUID}=="EDGESTORE-KEY-01", RUN+="/usr/bin/systemctl start edgestore-lock.service"
